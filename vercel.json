{
  "version": 2,
  "functions": {
    "app.py": {
      "runtime": "@vercel/python",
      "excludeFiles": "{portfolio_data/**,Images-works/**,unused-assests/**,LOGOS/**,*.png,*.jpg,*.jpeg,*.mp4}"
    }
  },
  "rewrites": [
    {
      "source": "/(portfolio_data|Images-works|LOGOS)/(.*)",
      "destination": "/$1/$2"
    },
    {
      "source": "/(.*\\.(png|jpg|jpeg|mp4|ico|svg|gif|css|js))",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/app.py"
    }
  ]
}
