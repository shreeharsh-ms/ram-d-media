{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(portfolio_data|Images-works|LOGOS)/(.*)",
      "dest": "/$1/$2"
    },
    {
      "src": "/(.*\\.(png|jpg|jpeg|mp4|ico|svg|gif|css|js))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "functions": {
    "app.py": {
      "excludeFiles": "{portfolio_data/**,Images-works/**,unused-assests/**,LOGOS/**,*.png,*.jpg,*.jpeg,*.mp4}"
    }
  }
}
